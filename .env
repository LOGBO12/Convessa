# URL complète du backend en production
# VITE_API_BASE_URL=https://careasy-realtime.alwaysdata.net
# VITE_SOCKET_URL=https://careasy-realtime.alwaysdata.net

# Configuration pour développement local avec Docker
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080

# Port du backend (dev local uniquement — ignoré si VITE_SOCKET_URL est défini)
VITE_BACKEND_PORT=3005
