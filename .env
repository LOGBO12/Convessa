# ──────────────────────────────────────────────────────────────────────────
# Convessa — Frontend — variables d'environnement (Vite)
# ──────────────────────────────────────────────────────────────────────────

# URL complète du backend Socket.io — ex: https://api.votre-domaine.com
# OBLIGATOIRE en production, laisser vide pour utiliser VITE_BACKEND_PORT en dev local
VITE_SOCKET_URL=

# Port du backend sur la même machine (utilisé uniquement si VITE_SOCKET_URL est vide)
VITE_BACKEND_PORT=3005
